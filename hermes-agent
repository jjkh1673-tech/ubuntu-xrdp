def interactive_mode():
    """Run Hermes agent in interactive mode."""
    agent = HermesAgent()

    print("\n" + "═" * 65)
    print("  🎤 HERMES AI AGENT - Terminal Mode")
    print(f"  Mode: {agent.mode.upper()}")
    print("  Type 'help' for commands, 'quit' to exit")
    print("═" * 65 + "\n")

    while True:
        try:
            user_input = input("You: ").strip()

            if user_input.lower() in ["quit", "exit", "q"]:
                print("\n👋 Goodbye!\n")
                break

            if not user_input:
                continue

            if user_input.lower() == "status":
                print("\n" + agent.get_status() + "\n")
                continue

            if user_input.lower() == "help":
                print("\n" + agent.local_assistant._get_help() + "\n")
                continue

            if user_input.lower() == "setup":
                wizard = SetupWizard(agent.config)
                if wizard.run():
                    agent._initialize()
                    print("\n✅ Setup complete! API key configured from: " + API_GUIDE_URL + "\n")
                else:
                    print("\n⚠️  Running in local mode.\n")
                continue

            response = agent.process(user_input)
            print(f"\nHermes: {response}\n")

        except KeyboardInterrupt:
            print("\n\n👋 Interrupted. Type 'quit' to exit.\n")
        except Exception as e:
            print(f"\n⚠️  Error: {e}\n")


