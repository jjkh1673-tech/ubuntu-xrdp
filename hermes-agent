# ============================================================================
# SETUP COMMAND
# ============================================================================

def setup():
    """Run setup to integrate Hermes into the system."""
    print("\n🔧 Setting up Hermes AI Agent...")
    print("-" * 50)
    
    create_icon()
    create_desktop_entry()
    
    # Make agent executable
    agent_path = Path(__file__).resolve()
    subprocess.run(["chmod", "+x", str(agent_path)], check=False)
    
    # Create symlink in /usr/local/bin
    try:
        subprocess.run(["ln", "-sf", str(agent_path), "/usr/local/bin/hermes-agent"], check=True)
        print("✅ Command 'hermes-agent' is now available system-wide")
    except Exception as e:
        print(f"⚠️  Could not create system symlink: {e}")
    
    print("-" * 50)
    print("✅ Setup complete! Launch Hermes from application menu or terminal.")
    print("   • Terminal: hermes-agent")
    print("   • Desktop: Click Hermes icon in Applications menu")
    print()


