class LocalAssistant:
    """Local assistant that works without API key."""

    def process(self, user_input: str) -> str:
        """Process user input."""
        user_input_lower = user_input.lower().strip()

        if any(word in user_input_lower for word in ["system", "os", "version", "info"]):
            return self._get_system_info()
        elif any(word in user_input_lower for word in ["memory", "ram", "cpu", "disk", "space"]):
            return self._get_resources()
        elif any(word in user_input_lower for word in ["docker", "container"]):
            return self._get_docker_info()
        elif any(word in user_input_lower for word in ["xrdp", "remote", "connect"]):
            return self._get_xrdp_help()
        elif user_input_lower in ["help", "?", "commands"]:
            return self._get_help()
        elif user_input_lower == "status":
            return self._get_status()
        elif any(word in user_input_lower for word in ["error", "fail", "problem", "issue"]):
            return self._get_troubleshooting(user_input)
        elif any(word in user_input_lower for word in ["setup", "api key", "apikey"]):
            return self._get_setup_help()
        elif any(word in user_input_lower for word in ["hello", "hi", "hey"]):
            return self._get_greeting()
        else:
            return self._get_contextual_help(user_input)

    def _get_system_info(self) -> str:
        try:
            os_info = subprocess.getoutput("cat /etc/os-release 2>/dev/null | grep PRETTY_NAME | cut -d'\"' -f2")
