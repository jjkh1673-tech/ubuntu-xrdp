if __name__ == "__main__":
    # Handle command-line arguments
    if len(sys.argv) > 1:
        command = sys.argv[1].lower()
        
        if command == "setup":
            setup()
        elif command == "status":
            agent = HermesAgent()
            print(agent.get_status())
        elif command == "help":
            agent = HermesAgent()
            print(agent.local_assistant._get_help())
        else:
            # Treat as query
            command_line_mode(" ".join(sys.argv[1:]))
    else:
