class HermesAgent:
    """
    Main controller that manages the Hermes AI Agent.
    Auto-detects configuration and routes to appropriate assistant.
    """
    
    def __init__(self):
        self.config = ConfigManager()
        self.local_assistant = LocalAssistant()
        self.cloud_assistant = None
        self.mode = "local"
        self._initialize()
    
    def _initialize(self):
        """Initialize agent based on configuration."""
        # Check if setup is complete
        if not self.config.is_setup_complete():
            # First run - setup wizard will be triggered
            self.mode = "setup_required"
            return
        
        # Check for API key
        for provider in ["openai", "anthropic"]:
            if self.config.has_api_key(provider):
                self.cloud_assistant = CloudAIAssistant(provider)
                self.mode = provider
                return
        
        # Default to local mode
        self.mode = "local"
    
    def process(self, user_input: str) -> str:
        """Process user input and return response."""
        # Log query
        self._log_query(user_input)
        
        # Route to appropriate assistant
        if self.mode == "setup_required":
            # Trigger setup wizard
            wizard = SetupWizard(self.config)
            if wizard.run():
                # Setup successful, re-initialize
                self._initialize()
                # Process the query with new configuration
                return self._process_with_assistant(user_input)
            else:
                # Setup skipped or failed, use local mode
                self.mode = "local"
                return self.local_assistant.process(user_input)
        
        elif self.mode != "local" and self.cloud_assistant:
            return self.cloud_assistant.query(user_input)
        else:
            return self.local_assistant.process(user_input)
    
    def _process_with_assistant(self, user_input: str) -> str:
        """Process query after setup is complete."""
        if self.mode != "local" and self.cloud_assistant:
            return self.cloud_assistant.query(user_input)
        else:
            return self.local_assistant.process(user_input)
    
    def _log_query(self, query: str):
        """Log query for usage tracking."""
        try:
            timestamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            with open(LOG_FILE, "a") as f:
                f.write(f"[{timestamp}] [{self.mode}] {query}\n")
        except:
            pass
    
    def get_status(self) -> str:
        """Get agent status."""
        config = ConfigManager()
        provider = config.get_active_provider()
        has_key = config.has_api_key()
        
        if self.mode == "setup_required":
            mode_display = "⏳ Setup Required"
        elif self.mode != "local":
            mode_display = f"🌐 {AI_PROVIDERS[self.mode]['name']}"
        else:
            mode_display = "📍 Local Mode"
        
        return f"""
╔════════════════════════════════════════════════════════════════╗
║                 🎤 HERMES AI AGENT STATUS                      ║
╠════════════════════════════════════════════════════════════════╣
║  Mode:              {mode_display:<55} ║
║  Provider:          {AI_PROVIDERS.get(provider, {}).get('name', 'N/A'):<55} ║
║  API Key:           {'✓ Configured' if has_key else '⏸️  Not configured':<52} ║
║  Config Directory:  {str(CONFIG_DIR):<53} ║
╚════════════════════════════════════════════════════════════════╝

  To configure API key: hermes-agent setup
        """


