class CloudAIAssistant:
    """
    Cloud-based AI assistant using OpenAI or Anthropic APIs.
    Requires API key configuration for full intelligence.
    """
    
    def __init__(self, provider: str = "openai"):
        self.provider = provider
        self.config = AI_PROVIDERS.get(provider)
        if not self.config:
            raise ValueError(f"Unknown provider: {provider}")
    
    def query(self, user_input: str, context: str = "") -> str:
        """Send query to cloud AI and return response."""
        api_key = os.environ.get(self.config["env_var"])
        
        if not api_key:
            return self._no_api_key_message()
        
        # For now, return a message indicating cloud mode needs implementation
        # In production, this would make actual API calls
        return f"""
🌐 Cloud AI Mode ({self.provider.title()})

Your {self.provider.title()} API key is configured.
Full AI capabilities would be available here.

To use cloud AI:
1. Set your API key: export {self.config['env_var']}='your-key-here'
2. Restart Hermes agent
3. Enjoy full AI intelligence!

(Note: Full API integration requires additional setup)
        """
    
    def _no_api_key_message(self) -> str:
        return """
🔑 Cloud AI Not Configured

To enable full AI capabilities, set your API key:

For OpenAI:
  $ export HERMES_OPENAI_API_KEY='sk-your-key-here'

For Anthropic:
  $ export HERMES_ANTHROPIC_API_KEY='your-key-here'

Then restart Hermes agent for full AI power!

Until then, I'm running in local mode with system assistance.
        """


# ============================================================================
# MAIN HERMES AGENT CONTROLLER
# ============================================================================

class HermesAgent:
    """
    Main controller that manages the Hermes AI Agent.
    Automatically selects the best mode available.
    """
    
    def __init__(self):
        self.local_assistant = LocalAssistant()
        self.cloud_assistant = None
        self.mode = "local"  # default to local for zero-setup
        self._detect_mode()
    
    def _detect_mode(self):
        """Auto-detect if cloud AI is available."""
        for provider in ["openai", "anthropic"]:
            if os.environ.get(AI_PROVIDERS[provider]["env_var"]):
                self.cloud_assistant = CloudAIAssistant(provider)
                self.mode = provider
                return
        
        # Default to local mode - zero setup required!
        self.mode = "local"
    
    def process(self, user_input: str) -> str:
        """Process user input and return response."""
        timestamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        
        # Log the query
        self._log_query(user_input, timestamp)
        
        # Route to appropriate assistant
        if self.mode != "local" and self.cloud_assistant:
            return self.cloud_assistant.query(user_input)
        else:
            return self.local_assistant.process(user_input)
    
    def _log_query(self, query: str, timestamp: str):
        """Log query for usage tracking (optional)."""
        try:
            with open(LOG_FILE, "a") as f:
                f.write(f"[{timestamp}] {query}\n")
        except:
            pass  # Don't fail if logging fails
    
    def get_status(self) -> str:
        """Get agent status information."""
        return f"""
╔═══════════════════════════════════════════════════════════╗
║                 🎤 HERMES AI AGENT STATUS                  ║
╠═══════════════════════════════════════════════════════════╣
║ Mode:              {self.mode.upper():<44} ║
║ Local Assistant:   ✅ Active (zero setup required)        ║
║ Cloud AI:          {'✅ Configured' if self.mode != 'local' else '⏸️  Not configured (optional)':<43} ║
║ Log File:          {str(LOG_FILE):<41} ║
╚═══════════════════════════════════════════════════════════╝
        """


# ============================================================================
# INTERACTIVE MODE
# ============================================================================

def interactive_mode():
    """Run Hermes agent in interactive mode."""
    agent = HermesAgent()
    
    print("\n" + "═" * 60)
    print("  🎤 HERMES AI AGENT - Interactive Mode")
    print("  Type 'help' for commands, 'quit' to exit")
    print("  Mode: " + agent.mode.upper() + " (type 'status' for details)")
    print("═" * 60 + "\n")
    
    while True:
        try:
            user_input = input("You: ").strip()
            
            if user_input.lower() in ["quit", "exit", "q"]:
                print("\n👋 Goodbye! Hermes agent will be here when you need me.\n")
                break
            
            if not user_input:
                continue
            
            if user_input.lower() == "status":
                print(agent.get_status())
                continue
            
            response = agent.process(user_input)
            print(f"\nHermes: {response}\n")
            
        except KeyboardInterrupt:
            print("\n\n👋 Interrupted. Type 'quit' to exit.\n")
        except Exception as e:
            print(f"\n⚠️  Error: {e}\n")


