class ConfigManager:
    """
    Manages Hermes configuration and credentials securely.
    First-run setup wizard handles API key configuration.
    """
    
    def __init__(self):
        self.config_dir = CONFIG_DIR
        self.config_file = CONFIG_FILE
        self.credentials_file = CREDENTIALS_FILE
        self.setup_flag = SETUP_WIZARD_FLAG
        
        # Ensure config directory exists
        self.config_dir.mkdir(parents=True, exist_ok=True)
    
    def is_setup_complete(self) -> bool:
        """Check if initial setup has been completed."""
        return self.setup_flag.exists()
    
    def has_api_key(self, provider: str = None) -> bool:
        """Check if API key is configured for provider."""
        if provider is None:
            # Check any provider
            for prov in AI_PROVIDERS:
                if self._get_credential(prov):
                    return True
            return False
        
        return self._get_credential(provider) is not None
    
    def get_active_provider(self) -> str:
        """Get the active/default AI provider."""
        config = self._load_config()
        return config.get("default_provider", "local")
    
    def set_default_provider(self, provider: str):
        """Set the default AI provider."""
        config = self._load_config()
        config["default_provider"] = provider
        self._save_config(config)
    
    def save_api_key(self, provider: str, api_key: str):
        """Securely save API key for provider."""
        credentials = self._load_credentials()
        credentials[AI_PROVIDERS[provider]["credential_key"]] = api_key
        self._save_credentials(credentials)
        
        # Also set as environment variable for current session
        os.environ[AI_PROVIDERS[provider]["env_var"]] = api_key
    
    def get_api_key(self, provider: str) -> str:
        """Get API key for provider (from credentials or environment)."""
        # First check environment variable
        env_key = os.environ.get(AI_PROVIDERS[provider]["env_var"])
        if env_key:
            return env_key
        
        # Then check stored credentials
        return self._get_credential(provider)
    
    def _get_credential(self, provider: str) -> str:
        """Get credential from stored file."""
        credentials = self._load_credentials()
        key = AI_PROVIDERS[provider]["credential_key"]
        return credentials.get(key)
    
    def _load_config(self) -> dict:
        """Load configuration file."""
        if self.config_file.exists():
            try:
                with open(self.config_file, "r") as f:
                    return json.load(f)
            except:
                pass
        return {}
    
    def _save_config(self, config: dict):
        """Save configuration file."""
        with open(self.config_file, "w") as f:
            json.dump(config, f, indent=2)
    
    def _load_credentials(self) -> dict:
        """Load credentials file."""
        if self.credentials_file.exists():
            try:
                with open(self.credentials_file, "r") as f:
                    return json.load(f)
            except:
                pass
        return {}
    
    def _save_credentials(self, credentials: dict):
        """Save credentials file with restricted permissions."""
        with open(self.credentials_file, "w") as f:
            json.dump(credentials, f, indent=2)
        
        # Set restrictive permissions (owner read/write only)
        os.chmod(self.credentials_file, 0o600)
    
    def mark_setup_complete(self):
        """Mark setup as complete."""
        with open(self.setup_flag, "w") as f:
            f.write(f"Setup completed at {datetime.datetime.now()}\n")
    
    def reset_setup(self):
        """Reset setup (for reconfiguration)."""
        if self.setup_flag.exists():
            self.setup_flag.unlink()
        
        if self.credentials_file.exists():
            self.credentials_file.unlink()
        
        if self.config_file.exists():
            self.config_file.unlink()
        
        print("✓ Setup reset complete. Run 'hermes-agent' to configure again.")


