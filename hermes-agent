class ConfigManager:
    """Manages Hermes configuration and credentials."""

    def __init__(self):
        self.config_dir = CONFIG_DIR
        self.config_file = CONFIG_FILE
        self.credentials_file = CREDENTIALS_FILE
        self.setup_flag = SETUP_WIZARD_FLAG
        self.config_dir.mkdir(parents=True, exist_ok=True)

    def is_setup_complete(self) -> bool:
        """Check if initial setup has been completed."""
        return self.setup_flag.exists()

    def has_api_key(self) -> bool:
        """Check if API key is configured."""
        # Check environment variable first
        if os.environ.get("HERMES_API_KEY"):
            return True
        # Check credentials file
        return self._get_credential() is not None

    def get_api_key(self) -> str:
        """Get API key from environment or credentials."""
        # Check environment variable first
        env_key = os.environ.get("HERMES_API_KEY")
        if env_key:
            return env_key
        # Then check stored credentials
        return self._get_credential()

    def _get_credential(self) -> str:
        """Get credential from stored file."""
        if self.credentials_file.exists():
            try:
                with open(self.credentials_file, "r") as f:
                    creds = json.load(f)
                    return creds.get("api_key")
            except:
                pass
        return None

    def save_api_key(self, api_key: str):
        """Save API key securely."""
        self.config_dir.mkdir(parents=True, exist_ok=True)
        with open(self.credentials_file, "w") as f:
            json.dump({
                "api_key": api_key,
                "saved_at": datetime.now().isoformat(),
                "provider": "custom_gateway"
            }, f, indent=2)
        os.chmod(self.credentials_file, 0o600)

    def mark_setup_complete(self):
        """Mark setup as complete."""
        with open(self.setup_flag, "w") as f:
            f.write(f"Setup completed at {datetime.now()}\n")

    def reset_setup(self):
        """Reset setup."""
        if self.setup_flag.exists():
            self.setup_flag.unlink()
        if self.credentials_file.exists():
            self.credentials_file.unlink()

