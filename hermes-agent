class LocalAssistant:
    """
    A rule-based local assistant that provides helpful responses
    without requiring any external API. Perfect for zero-setup experience.
    Optimized for high performance with pre-computed responses.
    """
    
    SYSTEM_INFO_CACHE = None
    RESOURCES_CACHE = None
    CACHE_TTL = 60  # Cache expires after 60 seconds
    
    def __init__(self):
        self._cache_timestamp = 0
    
    def process(self, user_input: str) -> str:
        """Process user input and return helpful response."""
        user_input_lower = user_input.lower().strip()
        
        # System queries
        if any(word in user_input_lower for word in ["system", "os", "version", "info", "details"]):
            return self._get_system_info()
        
        # Resource queries
        if any(word in user_input_lower for word in ["memory", "ram", "cpu", "disk", "space", "storage"]):
            return self._get_resources()
        
        # Docker queries
        if any(word in user_input_lower for word in ["docker", "container", "image", "ps", "ls"]):
            return self._get_docker_info()
        
        # XRDP queries
        if any(word in user_input_lower for word in ["xrdp", "remote", "rdp", "connect", "connection"]):
            return self._get_xrdp_help()
        
        # Help command
        if user_input_lower in ["help", "?", "commands", "list"]:
            return self._get_help()
        
        # Status
        if user_input_lower == "status":
            return self._get_status()
        
        # Troubleshooting
        if any(word in user_input_lower for word in ["error", "fail", "problem", "issue", "not working", "crash", "broken"]):
            return self._get_troubleshooting(user_input)
        
        # Setup/reconfigure
        if any(word in user_input_lower for word in ["setup", "configure", "api key", "apikey", "reconfigure"]):
            return self._get_setup_help()
        
        # Development
        if any(word in user_input_lower for word in ["code", "program", "develop", "python", "node", "git", "editor"]):
            return self._get_development_help()
        
        # Package management
        if any(word in user_input_lower for word in ["install", "package", "apt", "software", "app"]):
            return self._get_package_help()
        
        # Desktop
        if any(word in user_input_lower for word in ["desktop", "xfce", "wallpaper", "theme", "panel"]):
            return self._get_desktop_help()
        
        # AI agent itself
        if any(word in user_input_lower for word in ["hermes", "agent", "you", "yourself", "capabilities"]):
            return self._get_about()
        
        # Greetings
        if any(word in user_input_lower for word in ["hello", "hi", "hey", "greetings"]):
            return self._get_greeting()
        
        # Default: contextual help
        return self._get_contextual_help(user_input)
    
