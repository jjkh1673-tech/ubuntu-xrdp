class SetupWizard:
    """First-run setup wizard for API key configuration."""

    def __init__(self, config: ConfigManager):
        self.config = config
        self.api_key = None

    def run(self) -> bool:
        """Run the setup wizard."""
        print("\n" + "═" * 65)
        print("  🎤 HERMES AI AGENT - Setup")
        print("═" * 65)
        print()
        print("  To use Hermes AI Agent, you need an API key.")
        print()
        print(f"  🔑 Get your API key from: {API_GUIDE_URL}")
        print()
        print("  Steps:")
        print("  1. Visit the website above")
        print("  2. Sign up / Log in")
        print("  3. Copy your API key")
        print("  4. Paste it below")
        print()

        # Try environment variable first
        env_key = os.environ.get("HERMES_API_KEY")
        if env_key:
            confirm = input(f"  Found API key in environment. Use it? [Y/n]: ").strip().lower()
            if confirm != "n":
                self.api_key = env_key
                print("  ✓ Using API key from environment")
                self._save_and_complete()
                return True

        # Prompt for API key
        while True:
            print("  Enter your API key (or 'skip' for local mode):")
            api_key = getpass.getpass("  API Key: ").strip()

            if api_key.lower() == "skip":
                print("\n  ✓ Running in local mode (no API key)")
                return False

            if api_key:
                self.api_key = api_key
                break
            else:
                print("  ✗ API key cannot be empty.")

        if not self.api_key:
            return False

        self._save_and_complete()
        return True

    def _save_and_complete(self):
        """Save API key and complete setup."""
        print()
        print("─" * 65)
        print("  Saving Configuration...")
        print("─" * 65)

        self.config.save_api_key(self.api_key)
        print("  ✓ API key saved securely")

        self.config.mark_setup_complete()
        print("  ✓ Setup complete")

        print()
        print("═" * 65)
        print("  ✅ HERMES AI AGENT READY!")
        print("═" * 65)
        print()
        print(f"  API Key configured from: {API_GUIDE_URL}")
        print("  Just type 'hermes-agent' to chat!")
        print()
        print("═" * 65 + "\n")


