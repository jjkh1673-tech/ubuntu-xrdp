                    continue
                
                self.api_key = api_key
                break
            else:
                print("  ✗ API key cannot be empty.")
    
    def _validate_api_key(self) -> bool:
        """Step 3: Validate the API key."""
        if not self.api_key:
            return False
        
        provider = AI_PROVIDERS[self.selected_provider]
        
        print()
