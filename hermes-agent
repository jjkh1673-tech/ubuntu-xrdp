class SetupWizard:
    """
    First-run setup wizard that guides users through API key configuration.
    Provides clear prompts, validates input, and auto-configures everything.
    """
    
    def __init__(self, config: ConfigManager):
        self.config = config
        self.selected_provider = None
        self.api_key = None
    
    def run(self) -> bool:
        """
        Run the setup wizard.
        Returns True if setup completed successfully.
        """
        print("\n" + "═" * 65)
        print("  🎤 HERMES AI AGENT - First Time Setup")
        print("═" * 65)
        print()
        print("  Welcome! Let's configure your AI assistant in 2 minutes.")
        print("  This setup only needs to be done ONCE.")
        print()
        
        # Step 1: Choose AI provider
        self._select_provider()
        if not self.selected_provider:
            print("\n⚠️  No provider selected. Running in local mode.")
            print("   You can reconfigure anytime with: hermes-agent setup\n")
            return False
        
