import urllib.request
import urllib.error

class CloudAIAssistant:
    """
    Cloud-based AI assistant using OpenAI or Anthropic APIs.
    Provides full AI intelligence with high performance.
    """
    
    def __init__(self, provider: str):
        self.provider = provider
        self.config = AI_PROVIDERS[provider]
    
    def query(self, user_input: str, context: str = "") -> str:
        """Send query to cloud AI and return response."""
        api_key = ConfigManager().get_api_key(self.provider)
        
        if not api_key:
            return "⚠️ API key not found. Run 'hermes-agent setup' to configure."
        
        return self._make_api_request(user_input)
    
    def _make_api_request(self, user_input: str) -> str:
        """Make API request to the AI provider."""
        provider = AI_PROVIDERS[self.provider]
        
        if self.provider == "openai":
            return self._query_openai(user_input)
        elif self.provider == "anthropic":
            return self._query_anthropic(user_input)
        else:
            return "Unknown provider."
    
    def _query_openai(self, user_input: str) -> str:
        """Query OpenAI API."""
        api_key = ConfigManager().get_api_key("openai")
        url = AI_PROVIDERS["openai"]["url"]
        model = AI_PROVIDERS["openai"]["model"]
        
        payload = json.dumps({
            "model": model,
            "messages": [
                {"role": "system", "content": "You are Hermes, a helpful AI assistant for Ubuntu XRDP desktop. Provide concise, helpful responses. If asked about system info, guide users with commands they can run."},
                {"role": "user", "content": user_input}
            ],
            "max_tokens": 1000,
            "temperature": 0.7
        }).encode('utf-8')
        
        req = urllib.request.Request(
            url,
            data=payload,
            headers={
                "Authorization": f"Bearer {api_key}",
                "Content-Type": "application/json"
            },
            method="POST"
        )
        
        try:
            with urllib.request.urlopen(req, timeout=30) as response:
                result = json.loads(response.read().decode('utf-8'))
                return result["choices"][0]["message"]["content"]
        except urllib.error.HTTPError as e:
            error_body = e.read().decode('utf-8')
            return f"⚠️ Error: {e.code} - {error_body[:200]}"
        except Exception as e:
            return f"⚠️ Error: {str(e)}"
    
    def _query_anthropic(self, user_input: str) -> str:
        """Query Anthropic API."""
        api_key = ConfigManager().get_api_key("anthropic")
        url = AI_PROVIDERS["anthropic"]["url"]
        model = AI_PROVIDERS["anthropic"]["model"]
        
        payload = json.dumps({
            "model": model,
            "max_tokens": 1000,
            "messages": [
                {"role": "user", "content": user_input}
            ]
        }).encode('utf-8')
        
        req = urllib.request.Request(
            url,
            data=payload,
            headers={
                "x-api-key": api_key,
                "Content-Type": "application/json",
                "anthropic-version": "2023-06-01"
            },
            method="POST"
        )
        
        try:
            with urllib.request.urlopen(req, timeout=30) as response:
                result = json.loads(response.read().decode('utf-8'))
                return result["content"][0]["text"]
        except urllib.error.HTTPError as e:
            error_body = e.read().decode('utf-8')
            return f"⚠️ Error: {e.code} - {error_body[:200]}"
        except Exception as e:
            return f"⚠️ Error: {str(e)}"


