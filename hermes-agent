                self.selected_provider = "openai"
                print(f"\n  ✓ Selected: {AI_PROVIDERS['openai']['name']}")
                break
            elif choice == "2":
                self.selected_provider = "anthropic"
                print(f"\n  ✓ Selected: {AI_PROVIDERS['anthropic']['name']}")
                break
            elif choice == "3":
                self.selected_provider = None
                print("\n  ✓ Local mode selected")
                break
            else:
                print("  ✗ Invalid choice. Please enter 1, 2, or 3.")
    
    def _get_api_key(self):
        """Step 2: Get API key from user."""
        if not self.selected_provider:
            return
        
        provider = AI_PROVIDERS[self.selected_provider]
        
        print()
        print("─" * 65)
        print(f"  STEP 2: Enter {provider['name']} API Key")
        print("─" * 65)
        print()
        print(f"  To get an API key:")
        print()
        
        if self.selected_provider == "openai":
            print("  1. Go to: https://platform.openai.com/api-keys")
            print("  2. Sign up/log in and create a new API key")
            print("  3. Copy the key (starts with 'sk-')")
        else:
            print("  1. Go to: https://console.anthropic.com/settings/keys")
            print("  2. Sign up/log in and create a new API key")
            print("  3. Copy the key")
        
        print()
        print("  ⚠️  Your key is stored securely and never shared.")
        print()
        
        # Try to get from environment first
        env_key = os.environ.get(provider["env_var"])
        if env_key:
            confirm = input(f"  Found API key in environment variable. Use it? [Y/n]: ").strip().lower()
            if confirm != "n":
                self.api_key = env_key
                print("  ✓ Using API key from environment")
                return
        
        # Prompt for API key
